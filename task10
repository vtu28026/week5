#include <bits/stdc++.h>
using namespace std;

void search(string pat, string txt) {
    int m = pat.size();
    int n = txt.size();

    for (int i = 0; i <= n - m; i++) {
        int j;

        for (j = 0; j < m; j++) {
            if (txt[i + j] != pat[j]) {
                break;
            }
        }

        if (j == m) {
            cout << "Pattern found at index " << i << endl;
        }
    }
}

int main() {
    string txt = "AABAACAADAABAABA";
    string pat = "AABA";

    search(pat, txt);

    return 0;
}
